# Optional, Benelux only. Needs knmi.enabled: true, the [knmi] extra and KNMI_API_KEY in the env file.
[Unit]
Description=roofcast KNMI satellite nowcast
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=roofcast
Group=roofcast
EnvironmentFile=/etc/roofcast/roofcast.env
StateDirectory=roofcast
WorkingDirectory=/var/lib/roofcast
ExecStart=/opt/roofcast/venv/bin/roofcast -c /etc/roofcast/config.yaml knmi
TimeoutStartSec=300
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
