[Unit]
Description=roofcast nightly calibration
After=network-online.target
Wants=network-online.target
# the Open-Meteo previous-runs API sometimes times out at night: retry up to 3 times, 20 min apart
StartLimitIntervalSec=4h
StartLimitBurst=4

[Service]
Type=oneshot
User=roofcast
Group=roofcast
EnvironmentFile=/etc/roofcast/roofcast.env
StateDirectory=roofcast
WorkingDirectory=/var/lib/roofcast
ExecStart=/opt/roofcast/venv/bin/roofcast -c /etc/roofcast/config.yaml learn
TimeoutStartSec=900
Restart=on-failure
RestartSec=20min
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
